+										// 补齐 call_id：下游 StreamResponseHandler/index.ts 依赖
+										// chunk.tool_call.call_id 建立 toolUseIdMap（call_id -> function.id）
+										// 缺失会导致 ToolResultUtils 无法回查 function.id，fallback 到 "cline"，
+										// 进而使 tool_result 无法正确配对回传给 LLM。
+										// Anthropic 协议下 tool_use block 的 id 即为 call_id，二者相同。
+										call_id: lastStartedToolCall.id,
+										function: {
+											...lastStartedToolCall,
+											id: lastStartedToolCall.id,
+											name: lastStartedToolCall.name,
+											arguments: chunk.delta.partial_json,
+										},
+									},
+								}
+							}
+							break
+					}
+					break
+				case "content_block_stop":
+					lastStartedToolCall.id = ""
+					lastStartedToolCall.name = ""
+					lastStartedToolCall.arguments = ""
+					break
+			}
+		}
+	}
+
+	getModel(): { id: DotsStudioAthrapiModelId; info: ModelInfo } {
+		const modelId = this.options.apiModelId
+
+		if (modelId && modelId in dotsStudioAthrapiModels) {
+			const id = modelId as DotsStudioAthrapiModelId
+			return { id, info: dotsStudioAthrapiModels[id] }
+		}
+		return { id: dotsStudioAthrapiDefaultModelId, info: dotsStudioAthrapiModels[dotsStudioAthrapiDefaultModelId] }
+	}
+}
